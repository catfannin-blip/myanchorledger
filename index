<style>
:root {
  --cream: #F5F2EC;
  --ink: #2C3830;
  --warm-mid: #7A9A8C;
  --soft: #D4E5DF;
  --white: #EBF4F0;
  --accent: #5F9E8A;
  --anchor-dark: #0b516b;
  --anchor-light: #72daff;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 56px; }
body {
  background: var(--cream);
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
  line-height: 1.7;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 6.5vw, 3.6rem);
  line-height: 1.15;
  font-weight: 700;
  margin-bottom: 1.1rem;
}
h1 em { font-style: italic; color: var(--accent); }
h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.3rem, 4vw, 1.7rem);
  font-weight: 700;
  margin-bottom: 0.9rem;
  line-height: 1.3;
}
p { margin-bottom: 1rem; color: #4a4038; }
.label {
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 500;
  margin-bottom: 0.75rem;
  display: block;
}
.divider { width: 48px; height: 2px; background: var(--anchor-dark); margin: 1.25rem 0; }

/* Skip link */
.skip-link {
  position: absolute; top: -100px; left: 1rem;
  background: var(--ink); color: var(--cream);
  padding: 0.5rem 1rem; border-radius: 2px;
  font-size: 0.85rem; z-index: 9999; text-decoration: none;
}
.skip-link:focus { top: 0.75rem; }

/* Nav */
.site-nav {
  position: sticky; top: 0; z-index: 200;
  background: rgba(245,242,236,0.96);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--soft);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 1.25rem; height: 56px; gap: 1rem;
}
.nav-brand {
  font-family: 'Playfair Display', serif;
  font-size: 1rem; font-weight: 700; color: var(--ink);
  text-decoration: none; display: flex; align-items: center; gap: 0.5rem;
}
.nav-brand svg { width: 24px; height: 24px; }
.nav-links { display: flex; align-items: center; gap: 1.5rem; list-style: none; }
.nav-links a {
  font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase;
  font-weight: 500; color: var(--ink); text-decoration: none;
  opacity: 0.7; transition: opacity 0.2s; padding: 0.5rem 0; display: inline-block;
}
.nav-links a:hover { opacity: 1; }
.nav-links .nav-cta {
  background: var(--ink); color: var(--cream);
  opacity: 1; padding: 0.45rem 1rem; border-radius: 2px;
}
.nav-toggle {
  display: none; background: none; border: none; cursor: pointer;
  color: var(--ink); min-width: 44px; min-height: 44px;
  align-items: center; justify-content: center;
}

/* Rope + anchor (signature feature) */
#anchor-rope-container {
  position: fixed; bottom: 0; right: 1.5rem; width: 60px;
  z-index: 98; pointer-events: none;
  display: flex; flex-direction: column; align-items: center;
}
#rope-svg {
  width: 12px; display: block; overflow: visible;
  animation: ropeSway 4s ease-in-out infinite;
  transform-origin: 50% 0%;
}
#anchor-icon {
  width: 48px; height: 48px; display: block;
  filter: drop-shadow(0 2px 6px rgba(11,81,107,0.18));
  transform-origin: 50% 8%;
  animation: anchorSway 4s ease-in-out infinite;
}
@keyframes anchorSway { 0%,100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
@keyframes ropeSway { 0%,100% { transform: skewX(-2deg); } 50% { transform: skewX(2deg); } }

/* Buttons */
.btn {
  background: var(--ink); color: var(--cream); text-decoration: none;
  padding: 0.9rem 2rem; font-size: 0.82rem; letter-spacing: 0.1em;
  text-transform: uppercase; font-weight: 500; border-radius: 2px;
  transition: background 0.2s; min-height: 44px;
  display: inline-flex; align-items: center; justify-content: center;
}
.btn:hover { background: var(--accent); }

/* Layout */
section { max-width: 760px; margin: 0 auto; padding: 4rem 1.5rem; }
#header { padding-top: 1rem; padding-bottom: 0; }
.band-mint { background: var(--white); border-top: 1px solid var(--soft); border-bottom: 1px solid var(--soft); }
.band-soft { background: var(--soft); }
.band-deep { background: var(--ink); color: var(--cream); }

/* Brand */
.brand { display: flex; align-items: center; justify-content: center; gap: 0.75rem; padding-top: 1rem; }
.brand svg { width: 40px; height: 40px; }
.brand-name { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; letter-spacing: 0.02em; }

/* Hero */
#hero { padding-top: 3rem; padding-bottom: 3.5rem; }
.hero-sub { font-size: 1.1rem; color: #5a5248; max-width: 520px; margin-bottom: 2rem; line-height: 1.7; }

/* Services */
.service-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 2rem; }
.service-card {
  background: var(--white); border: 1px solid var(--soft);
  border-top: 3px solid var(--anchor-dark);
  padding: 1.5rem 1.5rem 1.25rem; border-radius: 2px;
}
.service-card:nth-child(2) { border-top-color: var(--accent); }
.service-card h3, .service-also h3 {
  font-family: 'Playfair Display', serif; font-size: 1.1rem;
  font-weight: 700; line-height: 1.3; margin-bottom: 0.6rem;
}
.service-card p, .service-also p { font-size: 0.92rem; margin: 0; }
.service-also {
  margin-top: 1.25rem; background: var(--cream);
  border: 1px solid var(--soft); border-left: 3px solid var(--warm-mid);
  padding: 1.1rem 1.5rem; border-radius: 2px;
}
.service-also h3 { font-size: 1rem; margin-bottom: 0.25rem; }
.service-also .label { color: var(--warm-mid); margin-bottom: 0.35rem; font-size: 0.68rem; }

/* About */
.about-header { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.25rem; margin-bottom: 1.5rem; }
.about-header h2 { margin-bottom: 0.5rem; }
.about-header .divider { margin: 0.75rem auto 0; }
.headshot {
  width: auto; max-width: 240px; height: auto; border-radius: 2px;
  border: 1px solid var(--soft); background: var(--white); display: block;
}
.headshot-placeholder {
  width: 200px; height: 240px; align-items: center; justify-content: center;
  font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 700;
  color: var(--anchor-dark);
}
#about p { text-align: center; max-width: 600px; margin: 0 auto 1rem; }

/* Credibility */
#credibility { text-align: center; max-width: 680px; }
.band-deep .label { color: var(--anchor-light); }
blockquote {
  font-family: 'Playfair Display', serif; font-style: italic;
  font-size: clamp(1.1rem, 3.2vw, 1.4rem); line-height: 1.55;
  color: var(--cream); margin: 0.5rem 0 1.25rem;
}
figcaption { font-size: 0.85rem; color: var(--soft); line-height: 1.5; }
figcaption strong { font-family: 'Playfair Display', serif; font-weight: 700; display: block; color: var(--cream); font-size: 0.95rem; }

/* Contact */
.contact-block {
  background: var(--cream); border: 1px solid var(--soft);
  border-left: 4px solid var(--anchor-dark);
  padding: 1.5rem 1.75rem; border-radius: 2px; margin-top: 1.5rem;
}
.contact-block a {
  color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--accent);
  font-size: 1.1rem; display: inline-block; padding: 0.1rem 0; line-height: 1.5;
}
.contact-block a:hover { color: var(--accent); }
.contact-block div { margin-top: 0.85rem; }

/* Footer */
footer {
  background: var(--cream); border-top: 1px solid var(--soft);
  padding: 2.5rem 1.5rem; text-align: center; font-size: 0.8rem;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--warm-mid);
}
.footer-logo {
  font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--ink);
  letter-spacing: 0.02em; text-transform: none; margin-bottom: 0.5rem;
  display: inline-flex; align-items: center; gap: 0.5rem;
}
.footer-logo svg { width: 22px; height: 22px; }
.disclosure {
  max-width: 640px; margin: 2.5rem auto 0; padding-top: 2rem;
  border-top: 1px solid var(--soft); text-align: left;
  text-transform: none; letter-spacing: normal;
}
.disclosure p { font-size: 0.75rem; line-height: 1.65; color: var(--warm-mid); margin: 0; }

/* Tablet / mobile */
@media (max-width: 640px) {
  .nav-toggle { display: flex; }
  .nav-links {
    display: none; position: absolute; top: 56px; left: 0; right: 0;
    background: rgba(245,242,236,0.98); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--soft); flex-direction: column;
    gap: 0; padding: 0.5rem 0; z-index: 199;
  }
  .nav-links.open { display: flex; }
  .nav-links li { width: 100%; }
  .nav-links a { padding: 0.85rem 1.75rem; font-size: 0.9rem; min-height: 48px; display: flex; align-items: center; }
  .nav-links .nav-cta { margin: 0.5rem 1.75rem 0.75rem; justify-content: center; }

  /* Side padding doubles as a gutter so the rope never covers text */
  section, footer { padding-left: 1.75rem; padding-right: 1.75rem; }
  section { padding-top: 2.75rem; padding-bottom: 2.75rem; }
  #hero { padding-top: 2rem; padding-bottom: 2.5rem; }
  .btn { display: flex; width: 100%; }
  .service-grid { grid-template-columns: 1fr; gap: 1rem; }
  .contact-block a { font-size: 1.15rem; }

  #anchor-rope-container { right: 0; width: 28px; opacity: 0.85; }
  #anchor-icon { width: 26px; height: 26px; }
  .brand-name { font-size: 1.25rem; }
  .brand svg { width: 32px; height: 32px; }
}
@media (max-width: 400px) {
  .contact-block a { font-size: 1rem; word-break: break-all; }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  #anchor-icon, #rope-svg { animation: none; }
  html { scroll-behavior: auto; }
}
