<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  /* Mobile menu */
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var links = document.getElementById('nav-links');
    function close() { links.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false'); }
    toggle.addEventListener('click', function () {
      var open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    links.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', close); });
    document.addEventListener('click', function (e) {
      if (!toggle.contains(e.target) && !links.contains(e.target)) close();
    });
  })();

  /* Rope lengthens with scroll, measured against the current page height */
  (function () {
    var rope = document.getElementById('rope-svg');
    var icon = document.getElementById('anchor-icon');
    var container = document.getElementById('anchor-rope-container');
    var NAV_H = 56, MIN_ROPE = 40, MAX_ROPE = 480;
    var reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    function update() {
      var anchorH = icon.getBoundingClientRect().height || 48;
      var room = window.innerHeight - NAV_H - anchorH - 16;
      var maxRope = Math.max(MIN_ROPE, Math.min(MAX_ROPE, room));
      var ropeH;
      if (reduceQuery.matches) {
        ropeH = Math.round((MIN_ROPE + maxRope) / 2); /* static length, no scroll-driven motion */
      } else {
        var maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        var frac = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        ropeH = Math.round(MIN_ROPE + (maxRope - MIN_ROPE) * frac);
      }
      rope.style.height = ropeH + 'px';
      rope.setAttribute('viewBox', '0 0 12 ' + ropeH);
      rope.querySelectorAll('line').forEach(function (l) { l.setAttribute('y2', ropeH); });
    }

    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { update(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('load', update); /* recalc once fonts/images settle page height */
    if (window.ResizeObserver) new ResizeObserver(update).observe(document.body);
    if (reduceQuery.addEventListener) reduceQuery.addEventListener('change', update);
    update();
  })();
</script>
